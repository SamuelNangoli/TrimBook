# =============================================================================
# TrimBook environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Pooled connection string used by the app at runtime (e.g. Supabase pooler).
DATABASE_URL="postgresql://user:password@host:5432/trimbook?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. On Supabase this is the
# :5432 direct URL; locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/trimbook?schema=public"

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
# Base URL of the app (used for callbacks / links in emails).
# TrimBook dev server runs on port 3100 to avoid clashing with other Next apps.
AUTH_URL="http://localhost:3100"
NEXTAUTH_URL="http://localhost:3100"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# --- Passwordless sign-in (Google OAuth + email magic links) -----------------
# Google OAuth client (console.cloud.google.com). Leave blank to hide the
# Google button. Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend API key for magic-link emails (resend.com). Leave blank in dev — the
# sign-in link is printed to the server console instead of emailed.
AUTH_RESEND_KEY=""
EMAIL_FROM="TrimBook <onboarding@resend.dev>"

# --- Subscription / billing defaults (overridable per shop in DB) ------------
TRIAL_DAYS="14"
GRACE_PERIOD_DAYS="7"
BILLING_CYCLE_DAYS="30"
STARTER_PRICE_UGX="25000"
CANCELLED_RETENTION_DAYS="90"

# --- Cron job security -------------------------------------------------------
# Secret required to trigger /api/cron/subscriptions (Bearer token).
CRON_SECRET="replace-with-a-random-string"

# --- Payments (Phase 7 — placeholders for now) -------------------------------
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""

# --- Notifications (SMS / WhatsApp — abstracted behind a service) ------------
# (Email magic links use AUTH_RESEND_KEY above.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMS_PROVIDER_API_KEY=""
